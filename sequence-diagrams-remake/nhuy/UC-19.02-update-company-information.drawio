        <mxCell id="c1" value="&lt;div&gt;1. Submit Update Company&lt;/div&gt;&lt;div&gt;Information&lt;/div&gt;" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" parent="1" edge="1">
