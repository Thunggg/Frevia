            <mxPoint x="105" y="402" as="sourcePoint" />
            <mxPoint x="295" y="402" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c2" value="&lt;div&gt;2. GET&lt;/div&gt;&lt;div&gt;/api/backend/social-links&lt;/div&gt;" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" parent="1" edge="1">
