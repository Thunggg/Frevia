        </mxCell>
        <mxCell id="c2" value="&lt;div&gt;2. POST /api/auth/join-role&lt;/div&gt;" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" parent="1" edge="1">
