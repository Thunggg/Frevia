    <!-- ==================== EDGES / RELATIONSHIPS (NO OVERLAPS) ==================== -->
    <!-- 1. Route to Controller (Horizontal straight) -->
    <mxCell id="pay_e_route_ctrl" value="maps to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=block;endFill=1;fontSize=13;labelBackgroundColor=none;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" parent="1" source="pay_route" target="pay_ctrl" edge="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- 2. Route to AuthGuard (Corridor in 80px gap) -->
    <mxCell id="pay_e_route_auth" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;startArrow=none;endArrow=open;endSize=12;fontSize=13;labelBackgroundColor=none;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" parent="1" source="pay_route" target="pay_gAuth" edge="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="700" y="514" />
          <mxPoint x="700" y="598" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- 3. Overhead arch from Controller to Service (y=20, clean above all classes) -->
    <mxCell id="pay_e_ctrl_svc" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=none;endArrow=open;endSize=12;fontSize=13;labelBackgroundColor=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="pay_ctrl" target="pay_svc" edge="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1000" y="20" />
          <mxPoint x="2130" y="20" />
        </Array>
      </mxGeometry>
