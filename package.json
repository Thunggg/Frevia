{
  "name": "bazaar",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "infisical run --env=dev --path=/api -- pnpm --filter api exec nest start --watch",
    "dev:web": "infisical run --env=dev --path=/web -- pnpm --filter web exec next dev --port 3001",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "zod": "^4.4.3"
  }
}
