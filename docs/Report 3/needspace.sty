\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{needspace}[2010/09/12 v1.3d Reserve page space]

\newcommand{\needspace}[1]{%
  \begingroup
  \setlength{\dimen@}{#1}%
  \vskip\z@skip
  \penalty 9999
  \vskip \dimen@
  \penalty -9999
  \vskip -\dimen@
  \vskip \z@skip
  \endgroup
}

\newcommand{\Needspace}{\@ifstar\Needspace@s\Needspace@}

\newcommand{\Needspace@}[1]{%
  \begingroup
  \setlength{\dimen@}{#1}%
  \vskip\z@skip
  \penalty 9999
  \advance\dimen@\pagetotal
  \ifdim \dimen@>\pagegoal
    \break
  \fi
  \vskip\z@skip
  \endgroup
}

\newcommand{\Needspace@s}[1]{%
  \begingroup
  \setlength{\dimen@}{#1}%
  \vskip\z@skip
  \penalty 9999
  \advance\dimen@\pagetotal
  \ifdim \dimen@>\pagegoal
    \newpage
  \fi
  \vskip\z@skip
  \endgroup
}
\endinput
