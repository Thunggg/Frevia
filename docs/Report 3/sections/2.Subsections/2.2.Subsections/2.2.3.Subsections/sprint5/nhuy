\subparagraph{UC-47.02 View Profile Update Request Detail}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline

UC ID and Name & \multicolumn{3}{l|}{UC-47.02 View Profile Update Request Detail} \\ \hline

Created By: & Nguyen Lu Nhat Huy & Date Created: & 24/10/2026 \\ \hline

Primary Actor: & Admin & Secondary Actors: & N/A \\ \hline

Trigger: & \multicolumn{3}{L{11.1cm}|}{The Admin selects a profile update request from the review list.} \\ \hline

Description: & \multicolumn{3}{L{11.1cm}|}{Displays the current profile snapshot and proposed changes for one update request.} \\ \hline

Preconditions: & \multicolumn{3}{L{11.1cm}|}{\textbf{PRE-1} The Admin is authorized. \newline \textbf{PRE-2} The selected profile revision exists.} \\ \hline

Post-conditions: & \multicolumn{3}{L{11.1cm}|}{The Admin can compare current and proposed values before making a decision.} \\ \hline

Normal Flow: & \multicolumn{3}{L{11.1cm}|}{\textbf{A. View Request Detail} \newline 1. The Admin selects a request. \newline 2. The system retrieves the revision by ID. \newline 3. The system displays requester details, current data, proposed data, profile strength, current status, and any review notes. \newline 4. For a pending request, the system presents Approve and Reject actions.} \\ \hline

Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline

Exceptions: & \multicolumn{3}{L{11.1cm}|}{\textbf{EX-01: Request Not Found} \newline 1. The revision ID is invalid or unavailable. \newline 2. The system displays a not-found message.} \\ \hline

Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline

Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline

Business Rules: & \multicolumn{3}{L{11.1cm}|}{BR-PR-03: The detail view must preserve both the current-data and proposed-data snapshots.} \\ \hline

Other Information: & \multicolumn{3}{L{11.1cm}|}{The detail is served by \texttt{GET /admin/profile-revisions/:id}.} \\ \hline

