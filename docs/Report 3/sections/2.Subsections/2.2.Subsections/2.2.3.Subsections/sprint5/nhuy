\subparagraph{UC-47.05 View Profile Update Request History}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline

UC ID and Name & \multicolumn{3}{l|}{UC-47.05 View Profile Update Request History} \\ \hline

Created By: & Nguyen Lu Nhat Huy & Date Created: & 27/10/2026 \\ \hline

Primary Actor: & Admin & Secondary Actors: & N/A \\ \hline

Trigger: & \multicolumn{3}{L{11.1cm}|}{The Admin searches or filters processed profile update requests.} \\ \hline

Description: & \multicolumn{3}{L{11.1cm}|}{Allows an administrator to view approved and rejected profile update requests.} \\ \hline

Preconditions: & \multicolumn{3}{L{11.1cm}|}{\textbf{PRE-1} The Admin is authenticated and authorized. \newline \textbf{PRE-2} Processed revision records are retained by the system.} \\ \hline

Post-conditions: & \multicolumn{3}{L{11.1cm}|}{A paginated history showing status, review notes, reviewer, and review time is displayed.} \\ \hline

Normal Flow: & \multicolumn{3}{L{11.1cm}|}{\textbf{A. View Request History} \newline 1. The Admin chooses a processed-status filter. \newline 2. The system retrieves revisions with status \texttt{APPROVED} or \texttt{REJECTED}. \newline 3. The Admin may search by user or filter by profile type. \newline 4. The system displays the history and provides access to each detail view.} \\ \hline

Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{\textbf{A.1 No Matching History} \newline 1. No processed requests match the selected filters. \newline 2. The system displays an empty-state message.} \\ \hline

Exceptions: & \multicolumn{3}{L{11.1cm}|}{\textbf{EX-01: Retrieval Error} \newline 1. The system cannot retrieve the history. \newline 2. The system displays an error and keeps the current filter state.} \\ \hline

Priority: & \multicolumn{3}{L{11.1cm}|}{Medium} \\ \hline

Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{Medium} \\ \hline

Business Rules: & \multicolumn{3}{L{11.1cm}|}{BR-PR-08: Approved and rejected revisions remain available for audit history.} \\ \hline

Other Information: & \multicolumn{3}{L{11.1cm}|}{The same list endpoint is used with processed-status filters.} \\ \hline

Assumptions: & \multicolumn{3}{L{11.1cm}|}{Review metadata is stored for every processed request.} \\ \hline

\end{longtable}

