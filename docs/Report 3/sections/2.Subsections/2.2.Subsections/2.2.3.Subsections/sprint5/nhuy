\subparagraph{UC-47.01 View Pending Profile Update Request List}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline

UC ID and Name & \multicolumn{3}{l|}{UC-47.01 View Pending Profile Update Request List} \\ \hline

Created By: & Nguyen Lu Nhat Huy & Date Created: & 23/10/2026 \\ \hline

Primary Actor: & Admin & Secondary Actors: & N/A \\ \hline

Trigger: & \multicolumn{3}{L{11.1cm}|}{The Admin opens the Profile Update Requests page.} \\ \hline

Description: & \multicolumn{3}{L{11.1cm}|}{Allows an administrator to retrieve profile update requests awaiting manual review.} \\ \hline

Preconditions: & \multicolumn{3}{L{11.1cm}|}{\textbf{PRE-1} The Admin is authenticated and authorized to review profiles. \newline \textbf{PRE-2} The system can access profile revision records.} \\ \hline

Post-conditions: & \multicolumn{3}{L{11.1cm}|}{A paginated list of matching profile update requests is displayed.} \\ \hline

Normal Flow: & \multicolumn{3}{L{11.1cm}|}{\textbf{A. View Pending Requests} \newline 1. The Admin opens the review page. \newline 2. The system retrieves profile revisions with status \texttt{PENDING}. \newline 3. The Admin may filter by profile type, status, or search keyword. \newline 4. The system displays each request with the requester, profile type, submission time, and profile strength.} \\ \hline

Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{\textbf{A.1 No Pending Requests} \newline 1. The system finds no matching revisions. \newline 2. The system displays an empty-state message.} \\ \hline

Exceptions: & \multicolumn{3}{L{11.1cm}|}{\textbf{EX-01: Unauthorized Access} \newline 1. A non-admin user requests the review list. \newline 2. The system denies access.} \\ \hline

Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline

Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline

Business Rules: & \multicolumn{3}{L{11.1cm}|}{BR-PR-01: Only authorized administrators may access profile revision requests. \newline BR-PR-02: List results are paginated and may be filtered by revision status and profile type.} \\ \hline

Other Information: & \multicolumn{3}{L{11.1cm}|}{The list is served by \texttt{GET /admin/profile-revisions}.} \\ \hline

Assumptions: & \multicolumn{3}{L{11.1cm}|}{Profile update requests have been created by users.} \\ \hline

\end{longtable}

