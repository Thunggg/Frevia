\end{longtable}

% =================================================================
% UC-47.03 Approve Profile Update Request
% =================================================================
\subparagraph{UC-47.03 Approve Profile Update Request}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline

UC ID and Name & \multicolumn{3}{l|}{UC-47.03 Approve Profile Update Request} \\ \hline

Created By: & Nguyen Lu Nhat Huy & Date Created: & 25/10/2026 \\ \hline

Primary Actor: & Admin & Secondary Actors: & System \\ \hline

Trigger: & \multicolumn{3}{L{11.1cm}|}{The Admin confirms approval of a pending update request.} \\ \hline

Description: & \multicolumn{3}{L{11.1cm}|}{Approves a request and applies its validated proposed data to the user's live profile.} \\ \hline

Preconditions: & \multicolumn{3}{L{11.1cm}|}{\textbf{PRE-1} The Admin is authorized. \newline \textbf{PRE-2} The revision exists and has status \texttt{PENDING}.} \\ \hline

Post-conditions: & \multicolumn{3}{L{11.1cm}|}{\textbf{POST-1} The revision status becomes \texttt{APPROVED}. \newline \textbf{POST-2} The approved data is applied to the appropriate live profile. \newline \textbf{POST-3} The requester receives an approval notification.} \\ \hline

Normal Flow: & \multicolumn{3}{L{11.1cm}|}{\textbf{A. Approve Request} \newline 1. The Admin reviews the current and proposed data. \newline 2. The Admin optionally enters review notes and selects Approve. \newline 3. The system validates the proposed data for the revision's profile type. \newline 4. The system updates the live profile and marks the revision \texttt{APPROVED}. \newline 5. The system records the reviewing Admin and review time. \newline 6. The system notifies the requester of approval.} \\ \hline

Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline

Exceptions: & \multicolumn{3}{L{11.1cm}|}{\textbf{EX-01: Request Already Reviewed} \newline 1. The request is not pending. \newline 2. The system rejects the action without changing profile data. \newline \textbf{EX-02: Invalid Proposed Data} \newline 1. Validation fails. \newline 2. The system preserves the live profile and reports the error.} \\ \hline

Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline

Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline

Business Rules: & \multicolumn{3}{L{11.1cm}|}{BR-PR-04: Only a pending revision may be approved. \newline BR-PR-05: Approval must apply the revision atomically and retain review metadata.} \\ \hline

Other Information: & \multicolumn{3}{L{11.1cm}|}{The action is served by \texttt{PATCH /admin/profile-revisions/:id/approve}.} \\ \hline

Assumptions: & \multicolumn{3}{L{11.1cm}|}{The Admin has verified that the proposed information is acceptable.} \\ \hline

\end{longtable}

% =================================================================
% UC-47.04 Reject Profile Update Request
% =================================================================
\subparagraph{UC-47.04 Reject Profile Update Request}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline

UC ID and Name & \multicolumn{3}{l|}{UC-47.04 Reject Profile Update Request} \\ \hline

Created By: & Nguyen Lu Nhat Huy & Date Created: & 26/10/2026 \\ \hline

Primary Actor: & Admin & Secondary Actors: & System \\ \hline

Trigger: & \multicolumn{3}{L{11.1cm}|}{The Admin rejects a pending profile update request.} \\ \hline

Description: & \multicolumn{3}{L{11.1cm}|}{Rejects a request with a reason while leaving the live profile unchanged.} \\ \hline

Preconditions: & \multicolumn{3}{L{11.1cm}|}{\textbf{PRE-1} The Admin is authorized. \newline \textbf{PRE-2} The revision exists and has status \texttt{PENDING}. \newline \textbf{PRE-3} A rejection reason is provided.} \\ \hline

Post-conditions: & \multicolumn{3}{L{11.1cm}|}{\textbf{POST-1} The revision status becomes \texttt{REJECTED}. \newline \textbf{POST-2} The live profile remains unchanged. \newline \textbf{POST-3} The requester is notified with the rejection reason.} \\ \hline

Normal Flow: & \multicolumn{3}{L{11.1cm}|}{\textbf{A. Reject Request} \newline 1. The Admin opens a pending request. \newline 2. The Admin enters review notes explaining the rejection. \newline 3. The Admin confirms Reject. \newline 4. The system marks the revision \texttt{REJECTED} and records the notes, reviewer, and review time. \newline 5. The system keeps existing profile data unchanged and notifies the requester.} \\ \hline

Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{\textbf{A.1 Cancel Rejection} \newline 1. The Admin cancels before confirmation. \newline 2. The request remains pending.} \\ \hline

Exceptions: & \multicolumn{3}{L{11.1cm}|}{\textbf{EX-01: Missing Review Notes} \newline 1. The Admin submits no reason. \newline 2. The system requires review notes and does not reject the request. \newline \textbf{EX-02: Request Already Reviewed} \newline 1. The request is no longer pending. \newline 2. The system rejects the action.} \\ \hline

Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline

Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{Medium} \\ \hline

Business Rules: & \multicolumn{3}{L{11.1cm}|}{BR-PR-06: Rejection notes are mandatory. \newline BR-PR-07: Rejecting a request must never update live profile data.} \\ \hline

Other Information: & \multicolumn{3}{L{11.1cm}|}{The action is served by \texttt{PATCH /admin/profile-revisions/:id/reject}.} \\ \hline

Assumptions: & \multicolumn{3}{L{11.1cm}|}{The requester can view the rejection result through the relevant profile experience.} \\ \hline

\end{longtable}

