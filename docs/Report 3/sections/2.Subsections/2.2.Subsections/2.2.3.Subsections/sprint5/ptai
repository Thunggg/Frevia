\subparagraph{UC Delete CV}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline

UC ID and Name & \multicolumn{3}{l|}{UC Delete CV} \\ \hline

Created By: & Tran Phat Tai & Date Created: & DD/MM/YYYY \\ \hline

Primary Actor: & Freelancer & Secondary Actors: & N/A \\ \hline

Trigger: & \multicolumn{3}{L{11.1cm}|}{When a freelancer chooses to delete the CV on their profile.} \\ \hline

Description: & \multicolumn{3}{L{11.1cm}|}{Allows a freelancer to remove their uploaded CV from their profile.} \\ \hline

Preconditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{PRE-1} The freelancer is authenticated.
} \\ \hline

Post-conditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{POST-1} The CV is removed from the freelancer's profile. \newline
\textbf{POST-2} The profile no longer exposes a CV.
} \\ \hline

Normal Flow: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A. Delete CV} \newline
1. The Freelancer chooses to delete the CV. \newline
2. The system asks for confirmation of the deletion. \newline
3. The Freelancer confirms the deletion. \newline
4. The system removes the CV reference from the freelancer's profile. \newline
5. The system confirms the deletion to the Freelancer. The use case ends.
} \\ \hline

Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{

\textbf{A.1 Cancel Delete} \textit{(branch at step 3)} \newline
1. The Freelancer cancels the deletion. \newline
2. The system takes no action. \newline
3. The use case ends.
} \\ \hline

Exceptions: & \multicolumn{3}{L{11.1cm}|}{

\textbf{EX-01: CV Not Found} \textit{(branch at step 4)} \newline
1. The system determines that the freelancer has no CV uploaded. \newline
2. The system displays a message indicating no CV is available. \newline
3. The use case ends. \newline
\textbf{EX-02: System Error While Deleting} \textit{(branch at step 4)} \newline
1. The system cannot remove the CV due to a processing or connection error. \newline
2. The system displays the message ``Couldn't delete the CV. Please try again later.'' \newline
3. The freelancer remains on the current page without the CV being deleted. \newline
4. The use case ends.
} \\ \hline

Priority: & \multicolumn{3}{L{11.1cm}|}{Low} \\ \hline

Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{Low} \\ \hline

Business Rules: & \multicolumn{3}{L{11.1cm}|}{
BR-CV-08: Only a freelancer can delete their own CV. \newline
BR-CV-09: Deleting a CV removes the reference from the profile so it is no longer visible or downloadable.
} \\ \hline

Other Information: & \multicolumn{3}{L{11.1cm}|}{Deleting the CV does not delete the freelancer's profile or other profile data.} \\ \hline

Assumptions: & \multicolumn{3}{L{11.1cm}|}{The freelancer wants to remove their CV from the profile.} \\ \hline

\end{longtable}