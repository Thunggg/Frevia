\subparagraph{UC Replace CV}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline

UC ID and Name & \multicolumn{3}{l|}{UC Replace CV} \\ \hline

Created By: & Tran Phat Tai & Date Created: & DD/MM/YYYY \\ \hline

Primary Actor: & Freelancer & Secondary Actors: & N/A \\ \hline

Trigger: & \multicolumn{3}{L{11.1cm}|}{When a freelancer uploads a new CV file while a CV already exists on their profile.} \\ \hline

Description: & \multicolumn{3}{L{11.1cm}|}{Allows a freelancer to replace the existing CV with a new file.} \\ \hline

Preconditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{PRE-1} The freelancer is authenticated. \newline
\textbf{PRE-2} The selected file is in a supported format and within the allowed size limit.
} \\ \hline

Post-conditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{POST-1} The new CV file replaces the old one on the freelancer's profile. \newline
\textbf{POST-2} The old file is removed or no longer referenced.
} \\ \hline

Normal Flow: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A. Replace CV} \newline
1. The Freelancer chooses to upload a new CV while a CV already exists. \newline
2. The system presents a file selection. \newline
3. The Freelancer selects a new CV file. \newline
4. The system validates the file format and size. \newline
5. The system stores the new file. \newline
6. The system updates the freelancer's profile to reference the new CV file. \newline
7. The system confirms the replacement to the Freelancer. The use case ends.
} \\ \hline

Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{

\textbf{A.1 Cancel Replace} \textit{(branch at step 3)} \newline
1. The Freelancer abandons the file selection. \newline
2. No replacement is performed and the old CV remains. \newline
3. The use case ends. \newline
\textbf{A.2 Unsupported Format} \textit{(branch at step 4)} \newline
1. The system determines that the selected file type is not supported. \newline
2. The system displays an error message listing the supported formats. \newline
3. Return to step 3 of the main flow. \newline
\textbf{A.3 File Too Large} \textit{(branch at step 4)} \newline
1. The system determines that the file exceeds the allowed size limit. \newline
2. The system displays an error message indicating the size limit. \newline
3. Return to step 3 of the main flow.
} \\ \hline

Exceptions: & \multicolumn{3}{L{11.1cm}|}{

\textbf{EX-01: System Error While Replacing} \textit{(branch at step 5)} \newline
1. The system cannot store the new file due to a processing or connection error. \newline
2. The system displays the message ``Couldn't replace the CV. Please try again later.'' \newline
3. The previous CV remains active. \newline
4. The use case ends.
} \\ \hline

Priority: & \multicolumn{3}{L{11.1cm}|}{Medium} \\ \hline

Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{Low} \\ \hline

Business Rules: & \multicolumn{3}{L{11.1cm}|}{
BR-CV-06: Only a freelancer can replace their own CV. \newline
BR-CV-07: Replacing a CV updates the profile reference to the new file and invalidates the old one.
} \\ \hline

Other Information: & \multicolumn{3}{L{11.1cm}|}{Replacement keeps at most one CV per profile, consistent with UC Upload CV.} \\ \hline

Assumptions: & \multicolumn{3}{L{11.1cm}|}{The freelancer already has a CV uploaded to their profile.} \\ \hline

\end{longtable}

