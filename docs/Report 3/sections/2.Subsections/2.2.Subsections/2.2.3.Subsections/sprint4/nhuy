\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline
UC ID and Name & \multicolumn{3}{l|}{UC-24.3 Change Password} \\ \hline
Created By: & Nguyen Lu Nhat Huy & Date Created: & 14/09/2026 \\ \hline
Primary Actor: & Client, Freelancer, Admin & Secondary Actors: & N/A \\ \hline
Trigger: & \multicolumn{3}{L{11.1cm}|}{When an authenticated user submits the Change Password form in security settings.} \\ \hline
Description: & \multicolumn{3}{L{11.1cm}|}{Allows an authenticated user to update their account password securely by verifying their current password and providing a new strong password.} \\ \hline
Preconditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{PRE-1} User is authenticated. \newline
\textbf{PRE-2} User account uses password authentication (non-OAuth exclusive).
} \\ \hline
Post-conditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{POST-1} Account password hash is updated in database and existing sessions are refreshed.
} \\ \hline
Normal Flow: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A. Change Password} \newline
1. User enters current password, new password, and password confirmation. \newline
2. User clicks ``Update Password''. \newline
3. System verifies current password matches stored bcrypt hash. \newline
4. System validates new password meets complexity rules (min 8 chars, uppercase, number, special char). \newline
5. System checks password confirmation matches new password. \newline
6. System hashes new password with bcrypt (work factor 12) and updates database. \newline
7. System displays success message ``Password changed successfully.''
} \\ \hline
Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline
Exceptions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{EX-01: Incorrect Current Password} \newline
1. Current password verification fails. \newline
2. System displays ``Current password is incorrect.'' \newline
\textbf{EX-02: Weak New Password} \newline
1. New password fails complexity validation. \newline
