\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline
UC ID and Name & \multicolumn{3}{l|}{UC-22.3 Write Review} \\ \hline
Created By: & Nguyen Lu Nhat Huy & Date Created: & 14/09/2026 \\ \hline
Primary Actor: & Client, Freelancer & Secondary Actors: & N/A \\ \hline
Trigger: & \multicolumn{3}{L{11.1cm}|}{When a user clicks ``Write Review'' on a completed contract.} \\ \hline
Description: & \multicolumn{3}{L{11.1cm}|}{Allows a contract participant (Client or Freelancer) to submit a rating and feedback comment for the other party after contract completion.} \\ \hline
Preconditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{PRE-1} User is a participant in the contract. \newline
\textbf{PRE-2} Contract status is COMPLETED. \newline
\textbf{PRE-3} User has not already submitted a review for this contract.
} \\ \hline
Post-conditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{POST-1} A new review is inserted into \texttt{reviews} table and target user's average rating is re-calculated.
} \\ \hline
Normal Flow: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A. Write Review} \newline
1. User opens the Write Review dialog for a completed contract. \newline
2. User selects rating scores for overall and sub-criteria (Communication, Quality, Deadlines). \newline
3. User enters written feedback comment. \newline
4. User clicks ``Submit Review''. \newline
5. System validates that ratings are between 1 and 5 and comment is not empty. \newline
6. System inserts review record into \texttt{reviews}. \newline
7. System updates target user's overall average rating profile. \newline
8. System displays success message ``Review submitted successfully.''
} \\ \hline
Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A.1 Cancel Review} \newline
1. User clicks ``Cancel''. \newline
2. System discards input and closes dialog.
} \\ \hline
Exceptions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{EX-01: Already Reviewed} \newline
1. User has already submitted a review for this contract. \newline
2. System displays ``You have already reviewed this contract.'' \newline
3. The use case ends.
} \\ \hline
Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline
Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{Medium} \\ \hline
Business Rules: & \multicolumn{3}{L{11.1cm}|}{
BR-REV-03: Only contract participants can review each other. \newline
BR-REV-04: Unique constraint on (contract\_id, reviewer\_id) prevents duplicate reviews.
} \\ \hline
Other Information: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline
Assumptions: & \multicolumn{3}{L{11.1cm}|}{Contract is COMPLETED.} \\ \hline
\end{longtable}

