% UC-21.2 Join New Role
% =================================================================
\subparagraph{UC-21.2 Join New Role}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline
UC ID and Name & \multicolumn{3}{l|}{UC-21.2 Join New Role} \\ \hline
Created By: & Nguyen Lu Nhat Huy & Date Created: & 14/09/2026 \\ \hline
Primary Actor: & Client, Freelancer & Secondary Actors: & N/A \\ \hline
Trigger: & \multicolumn{3}{L{11.1cm}|}{When a user with a single role clicks ``Become a Freelancer'' or ``Become a Client'' in settings.} \\ \hline
Description: & \multicolumn{3}{L{11.1cm}|}{Allows a user with one role to activate the complementary role (Client adding Freelancer or vice versa), initializing the required role profile and enabling seamless role switching.} \\ \hline
Preconditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{PRE-1} User is authenticated. \newline
\textbf{PRE-2} User does not already possess the target role.
} \\ \hline
Post-conditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{POST-1} Target role is assigned in \texttt{user\_roles}, corresponding profile table is initialized, and new JWT is issued.
} \\ \hline
Normal Flow: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A. Join New Role} \newline
1. User clicks ``Become a Freelancer'' (or ``Become a Client''). \newline
2. System presents brief onboarding form for initial role details (e.g., title & skills for Freelancer, or company name for Client). \newline
3. User completes required fields and clicks ``Confirm''. \newline
4. System assigns target role in \texttt{user\_roles}. \newline
5. System creates corresponding \texttt{freelancer\_profiles} or \texttt{client\_profiles} record. \newline
6. System re-issues JWT updated with dual-role permissions and active role set to the new role. \newline
7. System redirects user to the new role dashboard with success message ``New role activated!''
} \\ \hline
Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A.1 Cancel Activation} \newline
1. User clicks ``Cancel'' during onboarding. \newline
2. System discards input and returns to account settings.
} \\ \hline
Exceptions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{EX-01: Role Already Active} \newline
1. User already possesses both roles. \newline
2. System displays ``You already have this role activated.'' \newline
3. The use case ends.
} \\ \hline
Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline
Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{Low} \\ \hline
Business Rules: & \multicolumn{3}{L{11.1cm}|}{
BR-ROLE-03: Activating a new role must preserve existing account data and primary credentials.
} \\ \hline
Other Information: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline
Assumptions: & \multicolumn{3}{L{11.1cm}|}{User account is active.} \\ \hline
\end{longtable}
