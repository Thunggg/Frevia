\subparagraph{UC-21.1 Switch Role}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline
UC ID and Name & \multicolumn{3}{l|}{UC-21.1 Switch Role} \\ \hline
Created By: & Nguyen Lu Nhat Huy & Date Created: & 14/09/2026 \\ \hline
Primary Actor: & Client, Freelancer & Secondary Actors: & N/A \\ \hline
Trigger: & \multicolumn{3}{L{11.1cm}|}{When a dual-role user selects ``Switch to Client'' or ``Switch to Freelancer'' from the profile menu.} \\ \hline
Description: & \multicolumn{3}{L{11.1cm}|}{Allows users possessing both Client and Freelancer roles to switch their active working context seamlessly without logging out and back in.} \\ \hline
Preconditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{PRE-1} User is authenticated. \newline
\textbf{PRE-2} User holds both Client and Freelancer role assignments in \texttt{user\_roles}.
} \\ \hline
Post-conditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{POST-1} Active role context in session/JWT is updated and user is redirected to the corresponding dashboard.
} \\ \hline
Normal Flow: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A. Switch Role} \newline
1. User clicks the role switcher dropdown in header menu. \newline
2. User selects the alternative role (e.g., switch from Freelancer to Client context). \newline
3. System verifies user possesses the target role assignment. \newline
4. System re-issues session token / JWT with updated active role claim (\texttt{activeRole = CLIENT}). \newline
5. System updates navigation layout and redirects user to Client Dashboard. \newline
6. System displays message ``Switched context to Client.''
} \\ \hline
Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline
Exceptions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{EX-01: Single Role User} \newline
1. User only has one active role. \newline
2. System displays ``You do not have a secondary role. Click 'Join Role' to add one.'' \newline
3. System prompts UC-21.2.
} \\ \hline
Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline
Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline
Business Rules: & \multicolumn{3}{L{11.1cm}|}{
BR-ROLE-01: Context switching requires valid dual-role assignment in the database. \newline
BR-ROLE-02: Active role claim in JWT determines endpoint authorization access control.
} \\ \hline
Other Information: & \multicolumn{3}{L{11.1cm}|}{Avoids requiring re-authentication or password re-entry.} \\ \hline
Assumptions: & \multicolumn{3}{L{11.1cm}|}{User account has multiple activated roles.} \\ \hline
\end{longtable}

