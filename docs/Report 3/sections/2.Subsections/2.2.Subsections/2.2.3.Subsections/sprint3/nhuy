\subparagraph{UC-20.2 Mark Notification as Read}

\begin{longtable}{|L{3.2cm}|L{4.1cm}|L{2.7cm}|L{4.1cm}|}
\hline
UC ID and Name & \multicolumn{3}{l|}{UC-20.2 Mark Notification as Read} \\ \hline
Created By: & Nguyen Lu Nhat Huy & Date Created: & 14/09/2026 \\ \hline
Primary Actor: & Client, Freelancer, Admin & Secondary Actors: & N/A \\ \hline
Trigger: & \multicolumn{3}{L{11.1cm}|}{When a user clicks on an unread notification or clicks its ``Mark as read'' action.} \\ \hline
Description: & \multicolumn{3}{L{11.1cm}|}{Updates the read status (\texttt{isRead = true}) of a single notification.} \\ \hline
Preconditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{PRE-1} User is authenticated. \newline
\textbf{PRE-2} Notification belongs to the user and \texttt{isRead = false}.
} \\ \hline
Post-conditions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{POST-1} Notification \texttt{isRead} is set to true and header unread badge count decrements by 1.
} \\ \hline
Normal Flow: & \multicolumn{3}{L{11.1cm}|}{
\textbf{A. Mark Notification as Read} \newline
1. User clicks an unread notification item. \newline
2. System updates \texttt{isRead = true} in \texttt{notifications} table. \newline
3. System updates UI styling (removes highlight) and decrements unread counter badge. \newline
4. System redirects user to the target action URL.
} \\ \hline
Alternative Flows: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline
Exceptions: & \multicolumn{3}{L{11.1cm}|}{
\textbf{EX-01: Unauthorized Access} \newline
1. User attempts to update another user's notification. \newline
2. System rejects update request with 403 status.
} \\ \hline
Priority: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline
Frequency of Use: & \multicolumn{3}{L{11.1cm}|}{High} \\ \hline
Business Rules: & \multicolumn{3}{L{11.1cm}|}{
BR-NOTIF-03: Users can only mark their own notifications as read.
} \\ \hline
Other Information: & \multicolumn{3}{L{11.1cm}|}{N/A} \\ \hline
Assumptions: & \multicolumn{3}{L{11.1cm}|}{Notification exists.} \\ \hline
\end{longtable}

