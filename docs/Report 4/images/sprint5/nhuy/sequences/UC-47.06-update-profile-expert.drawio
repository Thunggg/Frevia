                    <mxGeometry as="geometry" x="1015" y="680.0" width="10" height="140.0" />
                </mxCell>
                <mxCell id="s10" value=":Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;labelBackgroundColor=none;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="1235" y="40" width="170" height="1440" />
                </mxCell>
                <mxCell id="s11" value="" style="html=1;points=[[0,0,0,0,5],[0,1,0,0,-5],[1,0,0,0,5],[1,1,0,0,-5]];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;" parent="1" vertex="1">
                    <mxGeometry as="geometry" x="1315" y="730.0" width="10" height="45.0" />
                </mxCell>
                <mxCell id="s12" value="&lt;div&gt;1. Forward original request with Bearer&lt;/div&gt;&lt;div&gt;token&lt;/div&gt;" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;labelBackgroundColor=none;" parent="1" edge="1">
