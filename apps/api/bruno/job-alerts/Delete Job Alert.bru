meta {
  name: Delete Job Alert
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/job-alerts/{{jobAlertId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

vars:pre-request {
  jobAlertId: 1
}

tests {
  test("Status should be 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Success should be true", function () {
    expect(res.getBody().success).to.equal(true);
  });
}
