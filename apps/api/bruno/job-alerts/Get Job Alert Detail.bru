meta {
  name: Get Job Alert Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/job-alerts/{{jobAlertId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Accept: application/json
}

vars:pre-request {
  jobAlertId: 1
}

tests {
  test("Status should be 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response should contain the requested Job Alert", function () {
    expect(res.getBody().success).to.equal(true);
    expect(res.getBody().data.id).to.be.a("number");
  });
}
