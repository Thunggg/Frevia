meta {
  name: Create permission
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/permissions
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "View permission list",
    "path": "/api/permissions",
    "method": "GET",
    "module": "PERMISSIONS"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
